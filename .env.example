# Choose one provider. Azure is the default because the original code used AzureOpenAI.
LLM_PROVIDER=azure

# Azure OpenAI settings.
# For Azure, model values are deployment names, not necessarily raw model IDs.
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding

# Alternative: public OpenAI API.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Alternative: Qwen / Alibaba Cloud Model Studio DashScope OpenAI-compatible API.
# Qwen model names are raw model names; no Azure-style deployment name is needed.
# Use qwen3.7-plus, qwen-vl-plus, or another vision-capable Qwen model for this project because
# the agent prompt includes image_url inputs.
# LLM_PROVIDER=qwen
# QWEN_API_KEY=your-qwen-or-dashscope-api-key
# DASHSCOPE_API_KEY=your-qwen-or-dashscope-api-key
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_CHAT_MODEL=qwen3.7-plus
# QWEN_EMBEDDING_MODEL=text-embedding-v4

# Alternative: any OpenAI-compatible endpoint (DeepSeek, Kimi, GLM, OpenAI).
# Use a vision-capable model: the Crafter prompt includes images.
# LLM_PROVIDER=compatible
# LLM_API_KEY=your-vendor-api-key
# LLM_BASE_URL=https://api.example.com/v1
# LLM_CHAT_MODEL=vendor-vision-model
# A compatible endpoint needs a separate embedding endpoint; any provider can use one:
# EMBEDDING_API_KEY=your-embedding-api-key
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v4
# Optional: json_object (validate locally and retry) or structured (provider-enforced).
# LLM_JSON_MODE=json_object
# Optional extra chat request fields as JSON, e.g. a fixed temperature.
# LLM_GENERATE_KWARGS={"temperature": 0.7}
